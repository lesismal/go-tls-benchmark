ARG GO_IMAGE=golang:1.27-bookworm
# The Rust toolchain for the rustls server and benchcli-rustls, copied out of
# the official image rather than installed with rustup, so that the build
# downloads nothing from rustup's servers. It links with the gcc the Go image
# already carries.
ARG RUST_IMAGE=rust:1.98-bookworm
FROM ${RUST_IMAGE} AS rust

FROM ${GO_IMAGE}

# Where the build downloads from; empty means the upstream default. Set by
# script/docker_benchmark.sh from its DOCKER_BENCH_* variables, which
# script/docker_benchmark_cn.sh points at mirrors reachable from mainland China.
# Build arguments only: none of them is left in the image's environment, and
# the benchmark itself runs with --network none.
#   APT_MIRROR  replaces http://deb.debian.org, e.g. https://mirrors.aliyun.com
#   GO_PROXY    GOPROXY for go mod download, e.g. https://goproxy.cn
#   CARGO_MIRROR  a sparse registry replacing crates.io for cargo, e.g.
#               sparse+https://rsproxy.cn/index/
ARG APT_MIRROR=
ARG GO_PROXY=
ARG CARGO_MIRROR=

COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# procps, psmisc and util-linux for pkill/killall and taskset, which the
# scripts stop the servers and pin them to their CPUs with. cmake for
# aws-lc-sys, the cryptography under rustls, where its build wants it, and for
# BoringSSL, under the uSockets server, with g++ for both.
RUN if [ -n "$APT_MIRROR" ]; then \
        for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
            if [ -f "$f" ]; then \
                sed -i "s|http://deb.debian.org|$APT_MIRROR|g; s|http://security.debian.org|$APT_MIRROR|g" "$f"; \
            fi; \
        done; \
    fi \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++ \
        procps \
        psmisc \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY go.mod go.sum ./
RUN if [ -n "$GO_PROXY" ]; then export GOPROXY="$GO_PROXY"; fi \
    && go mod download

# The rustls server and benchcli-rustls, their dependencies fetched and
# compiled into the image the way go mod download fetches the Go ones, so that
# script/build.sh builds them in the container with no network. Copied on
# their own ahead of the rest of the tree, so an edit elsewhere does not
# compile them again, and compiled to a target directory outside the
# workspace, which COPY . . leaves alone.
#
# A mirror is written to CARGO_HOME's config rather than passed for this one
# build: cargo caches what it downloads under the source it came from, so the
# offline build in the container has to name the same source to find it.
ENV CARGO_TARGET_DIR=/tmp/cargo-target
COPY frameworks/rustls /workspace/frameworks/rustls
COPY benchcli-rustls /workspace/benchcli-rustls
RUN if [ -n "$CARGO_MIRROR" ]; then \
        printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n' "$CARGO_MIRROR" \
            >> "$CARGO_HOME/config.toml"; \
    fi \
    && cargo build --release --locked --manifest-path frameworks/rustls/Cargo.toml \
    && cargo build --release --locked --manifest-path benchcli-rustls/Cargo.toml

# The uSockets server's and benchcli-usockets' sources - uSockets and
# BoringSSL, cloned at the releases frameworks/usockets/deps.sh pins, BoringSSL
# built - into a
# directory outside the workspace that the script reuses, so that
# script/build.sh builds the server in the container with no network.
ENV USOCKETS_DEPS_DIR=/tmp/usockets-deps
COPY frameworks/usockets /workspace/frameworks/usockets
COPY benchcli-usockets /workspace/benchcli-usockets
RUN bash frameworks/usockets/build.sh /tmp/usockets.server && rm /tmp/usockets.server \
    && bash benchcli-usockets/build.sh /tmp/bench.client && rm /tmp/bench.client

COPY . .

ENV GOCACHE=/tmp/go-build-cache \
    CARGO_NET_OFFLINE=true

CMD ["bash", "script/benchmark.sh"]
